pragma Unsafe_Module;

import Austral.Memory (Pointer);

module body Test is
    typeclass Tagged(T: Type) is
        method tag(value: T): Unit;
    end;

    instance Tagged(Bool) is
        method tag(value: Bool): Unit is
            return nil;
        end;
    end;

    generic [U: Type]
    instance Tagged(Pointer[U]) is
        method tag(value: Pointer[U]): Unit is
            return nil;
        end;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
