pragma Unsafe_Module;

import Austral.Memory (Address);

module body Test is
    typeclass Tagged(T: Type) is
        method tag(value: T): Unit;
    end;

    generic [U: Type]
    instance Tagged(Address[U]) is
        method tag(value: Address[U]): Unit is
            return nil;
        end;
    end;

    generic [V: Type]
    instance Tagged(Address[V]) is
        method tag(value: Address[V]): Unit is
            return nil;
        end;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
