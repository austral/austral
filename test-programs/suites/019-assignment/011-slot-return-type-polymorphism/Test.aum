module body Test is
    record Rec: Free is
        o: Option[Int32];
    end;

    generic [T: Free]
    function nothing(): Option[T] is
        return None();
    end;

    function show(x: Option[Int32]): Unit is
        case x of
            when Some(value: Int32) do
                printLn(value);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        var r: Rec := Rec(o => Some(value => 10));
        show(r.o);
        r.o := nothing();
        show(r.o);
        return ExitSuccess();
    end;
end module body.
