pragma Unsafe_Module;

import Austral.Memory (
    Pointer,
    Address,
    allocateBuffer,
    nullCheck,
    deallocate,
    span,
    spanWrite
);

module body Test is
    function allocateOrDie(): Pointer[Int64] is
        let addr: Address[Int64] := allocateBuffer(3);
        case nullCheck(addr) of
            when Some(value: Pointer[Int64]) do
                return value;
            when None do
                abort("Allocation failed.");
        end case;
    end;

    generic [R: Region]
    function writeValues(ref: &![Pointer[Int64], R]): Unit is
        var sp: Span![Int64, R] := spanWrite(ref, 0, 2);
        for i from 0 to 2 do
            sp[i] := 5;
        end for;
        return nil;
    end;

    generic [R: Region]
    function printValues(ref: &[Pointer[Int64], R]): Unit is
        let sp: Span[Int64, R] := span(ref, 0, 2);
        for i from 0 to 2 do
            let val: Int64 := sp[i];
            printLn(val);
        end for;
        return nil;
    end;

    function main(): ExitCode is
        var ptr: Pointer[Int64] := allocateOrDie();
        writeValues(&!ptr);
        printValues(&ptr);
        deallocate(ptr);
        return ExitSuccess();
    end;
end module body.
