module body Test is
    record Foo: Linear is
        x: Int32;
    end;

    function main(): ExitCode is
        let a: Foo := Foo(x => 1);
        let { x: Int32 } := if true then a else Foo(x => 2);
        let n: Int32 := if x > 0 then 10 else 20;
        printLn(x);
        printLn(n);
        return ExitSuccess();
    end;
end module body.
