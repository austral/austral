module body Test is
    function main(): ExitCode is
        var n: Int32 := 5;
        borrow r: &[Int32, R] := &n do
            let a: Int32 := n;
            printLn(a + !r);
        end borrow;
        borrow w: &![Int32, S] := &!n do
            let b: Int32 := n;
            printLn(b + !w);
        end borrow;
        return ExitSuccess();
    end;
end module body.
