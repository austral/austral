pragma Unsafe_Module;

import Austral.Memory (
    Pointer,
    Address,
    allocateBuffer,
    nullCheck,
    deallocate,
    spanWrite
);

module body Test is
    generic [T: Type]
    function same(x: T): T is
        return x;
    end;

    function allocateOrDie(): Pointer[Int32] is
        let addr: Address[Int32] := allocateBuffer(2);
        case nullCheck(addr) of
            when Some(value: Pointer[Int32]) do
                return value;
            when None do
                abort("Allocation failed.");
        end case;
    end;

    function main(): ExitCode is
        var ptr: Pointer[Int32] := allocateOrDie();
        borrow ref: &![Pointer[Int32], R] := &!ptr do
            var sp: Span![Int32, R] := same(spanWrite(ref, 0, 1));
            sp[0] := 11;
            printLn(sp[0]);
        end borrow;
        deallocate(ptr);
        return ExitSuccess();
    end;
end module body.
