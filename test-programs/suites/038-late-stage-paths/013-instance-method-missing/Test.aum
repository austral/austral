module body Test is
    typeclass Foo(T: Free) is
        method foo(value: T): Unit;
        method bar(value: T): Unit;
    end;

    instance Foo(Int32) is
        method foo(value: Int32): Unit is
            return nil;
        end;
    end;

    generic [T: Free(Foo)]
    function callBar(value: T): Unit is
        return bar(value);
    end;

    function main(): ExitCode is
        callBar(10);
        return ExitSuccess();
    end;
end module body.
