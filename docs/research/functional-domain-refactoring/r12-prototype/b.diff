diff --git a/lib/Outcome.ml b/lib/Outcome.ml
new file mode 100644
index 0000000..105bdb0
--- /dev/null
+++ b/lib/Outcome.ml
@@ -0,0 +1,33 @@
+open Error
+
+type 'a outcome = ('a, austral_error list) result
+
+let bind = Result.bind
+
+let ( let* ) = Result.bind
+
+let rec traverse (f: 'a -> 'b outcome) (list: 'a list): 'b list outcome =
+  match list with
+  | [] ->
+     Ok []
+  | first::rest ->
+     let* first = f first in
+     let* rest = traverse f rest in
+     Ok (first :: rest)
+
+(* The one place where a stage turns its exception into a value. *)
+let catch (f: unit -> 'a): 'a outcome =
+  try
+    Ok (f ())
+  with Austral_error error ->
+    Error [error]
+
+(* Temporary, until the caller of the stage returns an outcome itself. *)
+let or_raise (outcome: 'a outcome): 'a =
+  match outcome with
+  | Ok value ->
+     value
+  | Error (first::_) ->
+     raise (Austral_error first)
+  | Error [] ->
+     internal_err "A stage failed without an error."
