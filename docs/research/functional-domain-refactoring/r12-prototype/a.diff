+++ b/lib/Outcome.ml
@@ -0,0 +1,47 @@
+open Error
+
+type 'a outcome = ('a, austral_error list) result
+
+let bind = Result.bind
+
+let ( let* ) = Result.bind
+
+let rec traverse (f: 'a -> 'b outcome) (list: 'a list): 'b list outcome =
+  match list with
+  | [] ->
+     Ok []
+  | first::rest ->
+     let* first = f first in
+     let* rest = traverse f rest in
+     Ok (first :: rest)
+
+(* Util.iter_with_context, for a step that can fail. *)
+let rec fold (f: 'c -> 'a -> 'c outcome) (ctx: 'c) (list: 'a list): 'c outcome =
+  match list with
+  | [] ->
+     Ok ctx
+  | first::rest ->
+     let* ctx = f ctx first in
+     fold f ctx rest
+
+(* austral_raise, as a value. *)
+let fail (kind: error_kind) (text: ErrorText.err_text): 'a outcome =
+  Error [make_error kind text]
+
+(* internal_err, as a value. *)
+let internal_fail (message: string): 'a outcome =
+  Error [internal_error message]
+
+(* adorn_error_with_span, for a value. *)
+let with_span (span: Span.span) (outcome: 'a outcome): 'a outcome =
+  Result.map_error (List.map (add_span span)) outcome
+
+(* Temporary, until the caller of the stage returns an outcome itself. *)
+let or_raise (outcome: 'a outcome): 'a =
+  match outcome with
+  | Ok value ->
+     value
+  | Error (first::_) ->
+     raise (Austral_error first)
+  | Error [] ->
+     internal_err "A stage failed without an error."
