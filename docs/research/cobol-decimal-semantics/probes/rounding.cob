    DISPLAY "TOWARD-LESSER 2.349=" X
    COMPUTE X ROUNDED MODE IS TRUNCATION = 2.349
    DISPLAY "TRUNCATION 2.349=" X
    MOVE 0 TO X
    COMPUTE X ROUNDED MODE IS PROHIBITED = 2.345
        ON SIZE ERROR DISPLAY "PROHIBITED 2.345=size-error, X=" X
        NOT ON SIZE ERROR DISPLAY "PROHIBITED 2.345=" X
    END-COMPUTE
    COMPUTE X ROUNDED MODE IS PROHIBITED = 2.34
        ON SIZE ERROR DISPLAY "PROHIBITED 2.34=size-error, X=" X
        NOT ON SIZE ERROR DISPLAY "PROHIBITED 2.34=" X
    END-COMPUTE
    STOP RUN.
