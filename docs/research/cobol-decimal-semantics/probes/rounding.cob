    DISPLAY "NEAREST-TOWARD-ZERO 2.355=" X
    COMPUTE X ROUNDED MODE IS TOWARD-GREATER = 2.355
    DISPLAY "TOWARD-GREATER 2.355=" X
    COMPUTE X ROUNDED MODE IS TOWARD-LESSER = 2.355
    DISPLAY "TOWARD-LESSER 2.355=" X
    COMPUTE X ROUNDED MODE IS TRUNCATION = 2.355
    DISPLAY "TRUNCATION 2.355=" X
    COMPUTE X = -2.345
    DISPLAY "none -2.345=" X
    COMPUTE X ROUNDED = -2.345
    DISPLAY "rounded -2.345=" X
    COMPUTE X ROUNDED MODE IS AWAY-FROM-ZERO = -2.345
    DISPLAY "AWAY-FROM-ZERO -2.345=" X
    COMPUTE X ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = -2.345
    DISPLAY "NEAREST-AWAY-FROM-ZERO -2.345=" X
    COMPUTE X ROUNDED MODE IS NEAREST-EVEN = -2.345
    DISPLAY "NEAREST-EVEN -2.345=" X
    COMPUTE X ROUNDED MODE IS NEAREST-TOWARD-ZERO = -2.345
    DISPLAY "NEAREST-TOWARD-ZERO -2.345=" X
    COMPUTE X ROUNDED MODE IS TOWARD-GREATER = -2.345
    DISPLAY "TOWARD-GREATER -2.345=" X
    COMPUTE X ROUNDED MODE IS TOWARD-LESSER = -2.345
    DISPLAY "TOWARD-LESSER -2.345=" X
    COMPUTE X ROUNDED MODE IS TRUNCATION = -2.345
    DISPLAY "TRUNCATION -2.345=" X
    COMPUTE X = 2.3451
    DISPLAY "none 2.3451=" X
    COMPUTE X ROUNDED = 2.3451
    DISPLAY "rounded 2.3451=" X
    COMPUTE X ROUNDED MODE IS AWAY-FROM-ZERO = 2.3451
    DISPLAY "AWAY-FROM-ZERO 2.3451=" X
    COMPUTE X ROUNDED MODE IS NEAREST-AWAY-FROM-ZERO = 2.3451
