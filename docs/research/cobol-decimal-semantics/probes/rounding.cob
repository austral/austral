    DISPLAY "TOWARD-LESSER 2.3451=" X
    COMPUTE X ROUNDED MODE IS TRUNCATION = 2.3451
    DISPLAY "TRUNCATION 2.3451=" X
    COMPUTE X = 2.344
    DISPLAY "none 2.344=" X
    COMPUTE X ROUNDED = 2.344
    DISPLAY "rounded 2.344=" X
    COMPUTE X ROUNDED MODE IS AWAY-FROM-ZERO = 2.344
