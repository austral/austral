+               Text " and ";
+               Type (get_type r);
+               Text ". Convert one side with ";
+               Code "widen";
+               Text ", ";
+               Code "round";
+               Text " or ";
+               Code "exact";
+               Text "."
+             ]
+      | (a, b) ->
