+(* Decimal prototype (issue #19). Throwaway code.
+
+   Every Decimal operation becomes a TEmbed of a call into the C runtime, so the
+   typed AST, the monomorphizer and the code generator need no new node. *)
+
+let decimal_error (text: ErrorText.err_text) =
+  austral_raise TypeError text
+
+let decimal_literal_text (e: aexpr): string option =
+  match e with
+  | IntConstant s -> Some s
+  | FloatConstant s -> Some s
+  | _ -> None
+
+let parse_decimal_literal (text: string): DecimalLit.literal =
+  match DecimalLit.parse text with
+  | DecimalLit.Parsed lit ->
+     lit
+  | DecimalLit.HasExponent ->
+     decimal_error [
+         Text "The literal ";
+         Code text;
+         Text " uses exponent notation, which is not allowed for a Decimal literal."
+       ]
+  | DecimalLit.Malformed ->
+     decimal_error [
+         Text "The literal ";
+         Code text;
+         Text " cannot be read as a Decimal literal."
+       ]
+
+(* A literal in a position that expects Decimal[p, s]: it must be that type's value exactly. *)
+let decimal_literal_as (p: int) (s: int) (text: string): texpr =
+  let ty = DecimalTy (p, s) in
+  let lit = parse_decimal_literal text in
+  match DecimalLit.coefficient lit s with
+  | None ->
+     decimal_error [
+         Text "The literal ";
+         Code text;
+         Text " is not exactly representable in ";
+         Type ty;
+         Text ": it needs more than ";
+         Text (string_of_int s);
+         Text " fractional digits."
+       ]
+  | Some coef ->
+     if DecimalLit.fits_precision coef p then
+       TEmbed (ty, DecimalLit.c_literal coef, [])
+     else
+       decimal_error [
+           Text "The literal ";
+           Code text;
+           Text " is not exactly representable in ";
+           Type ty;
+           Text ": it does not fit in ";
+           Text (string_of_int p);
+           Text " digits."
+         ]
+
+(* A literal operand of `*` or of a Decimal built-in: the smallest type that holds its value. *)
+let decimal_literal_minimal (text: string): texpr =
+  let lit = parse_decimal_literal text in
+  let (p, s) = DecimalLit.minimal_type lit in
+  if p > 38 then
+    decimal_error [
+        Text "The literal ";
+        Code text;
+        Text " needs more than 38 digits, so it has no Decimal type."
+      ]
+  else
+    decimal_literal_as p s text
+
+let is_decimal_type (ty: ty): bool =
+  match ty with
+  | DecimalTy _ -> true
+  | _ -> false
