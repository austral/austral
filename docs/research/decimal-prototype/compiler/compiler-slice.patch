--- a/lib/DecimalLit.ml	1970-01-01 00:00:00.000000000 +0000
+++ b/lib/DecimalLit.ml	2026-11-12 14:53:29.342761331 +0000
@@ -0,0 +1,74 @@
+(* Throwaway prototype (issue #19): numeric literals read as Decimal[P, S].
+   Everything here works on the literal's text and on big integers. No floats. *)
+
+type literal = {
+    negative: bool;
+    int_digits: string;
+    (* Trailing zeros removed, so the length is the scale the value needs. *)
+    frac_digits: string;
+  }
+
+type parse_result =
+  | Parsed of literal
+  | HasExponent
+  | Malformed
+
+let all_digits (s: string): bool =
+  String.for_all (fun c -> c >= '0' && c <= '9') s
+
+let strip_trailing_zeros (s: string): string =
+  let n = ref (String.length s) in
+  while !n > 0 && s.[!n - 1] = '0' do decr n done;
+  String.sub s 0 !n
+
+let strip_leading_zeros (s: string): string =
+  let i = ref 0 in
+  while !i < String.length s && s.[!i] = '0' do incr i done;
+  String.sub s !i (String.length s - !i)
+
+(* The lexer's float rule is `sign? dec_constant period dec_constant? (exponent sign? dec_constant)?`
+   and dec_constant carries its own optional sign, so "1." and "1.-5" both arrive here. *)
+let parse (text: string): parse_result =
+  if String.contains text 'e' || String.contains text 'E' then
+    HasExponent
+  else
+    let (negative, body) =
+      if String.length text > 0 && (text.[0] = '-' || text.[0] = '+') then
+        (text.[0] = '-', String.sub text 1 (String.length text - 1))
+      else
+        (false, text)
+    in
+    let (int_digits, frac_digits) =
+      match String.index_opt body '.' with
+      | Some i -> (String.sub body 0 i, String.sub body (i + 1) (String.length body - i - 1))
+      | None -> (body, "")
+    in
+    if int_digits = "" || not (all_digits int_digits) || not (all_digits frac_digits) then
+      Malformed
+    else
+      Parsed { negative; int_digits; frac_digits = strip_trailing_zeros frac_digits }
+
+(* The coefficient at scale `s`, or None when the value has more than `s` fractional digits. *)
+let coefficient (lit: literal) (s: int): Z.t option =
+  let needed = String.length lit.frac_digits in
+  if needed > s then
+    None
+  else
+    let digits = lit.int_digits ^ lit.frac_digits ^ (String.make (s - needed) '0') in
+    let n = Z.of_string digits in
+    Some (if lit.negative then Z.neg n else n)
+
+let fits_precision (coef: Z.t) (p: int): bool =
+  Z.lt (Z.abs coef) (Z.pow (Z.of_int 10) p)
+
+(* The smallest (P, S) that holds the value exactly: `2` is (1, 0), `0.0825` is (4, 4), `1.50` is (2, 1). *)
+let minimal_type (lit: literal): int * int =
+  let s = String.length lit.frac_digits in
+  let significant = String.length (strip_leading_zeros (lit.int_digits ^ lit.frac_digits)) in
+  (max (max significant s) 1, s)
+
+(* C has no 128-bit literals, so the runtime rebuilds the coefficient from two 64-bit halves. *)
+let c_literal (coef: Z.t): string =
+  let chunk = Z.pow (Z.of_int 10) 19 in
+  let (hi, lo) = Z.div_rem (Z.abs coef) chunk in
+  Printf.sprintf "au_dec_lit(%d, %sULL, %sULL)" (if Z.sign coef < 0 then 1 else 0) (Z.to_string hi) (Z.to_string lo)
