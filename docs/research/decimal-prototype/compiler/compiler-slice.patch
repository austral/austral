+(* The Decimal built-ins. Most of them take their result type from the position,
+   which is why they cannot be ordinary functions: a function cannot read its
+   own type arguments as numbers. Returns None when the name is not a built-in
+   or the program defines something with that name. *)
+and augment_decimal_builtin (ctx: expr_ctx) (name: qident) (args: abstract_arglist) (asserted_ty: ty option): texpr option =
+  let builtin: string = ident_string (original_name name) in
+  let shadowed _ =
+    (get_var (ctx_lexenv ctx) (local_name name) <> None)
+    || (get_callable (ctx_env ctx) (ctx_module_name ctx) (qident_to_sident name) <> None)
+  in
+  if not (List.mem builtin decimal_builtin_names) || shadowed () then
+    None
+  else
+    let args: aexpr list =
+      match args with
+      | Positional args -> args
+      | Named _ ->
+         decimal_error [Text "The built-in "; Code builtin; Text " takes positional arguments."]
+    in
+    let wrong_arity (expected: int) =
+      decimal_error [
+          Text "The built-in ";
+          Code builtin;
+          Text " takes ";
+          Text (string_of_int expected);
+          Text " arguments, but I found ";
+          Text (string_of_int (List.length args));
+          Text "."
+        ]
+    in
+    (* A literal argument gets the smallest Decimal type that holds it. *)
+    let operand (e: aexpr): texpr =
+      match decimal_literal_text e with
+      | Some text -> decimal_literal_minimal text
+      | None -> aug ctx e
+    in
+    let decimal_operand (e: aexpr): texpr * int * int =
+      let e' = operand e in
+      match get_type e' with
+      | DecimalTy (p, s) -> (e', p, s)
+      | ty ->
+         decimal_error [
+             Text "The built-in ";
+             Code builtin;
+             Text " expects a Decimal value here, but got a value of type ";
+             Type ty;
+             Text "."
+           ]
+    in
+    let mode_operand (e: aexpr): texpr =
+      let e' = aug ctx e in
+      match get_type e' with
+      | NamedType (n, [], _) when (equal_module_name (source_module_name n) pervasive_module_name)
+                                  && (ident_string (original_name n) = "RoundingMode") ->
+         e'
+      | ty ->
+         decimal_error [
+             Text "The rounding mode of ";
+             Code builtin;
+             Text " must be a RoundingMode, for example ";
+             Code "NearestEven()";
+             Text ", but got a value of type ";
+             Type ty;
+             Text "."
+           ]
+    in
+    let no_result_type _ =
+      decimal_error [
+          Text "The result type of ";
+          Code builtin;
+          Text " comes from where it is used, and this position does not give one. Bind it with a type, as in ";
+          Code ("let x: Decimal[9, 4] := " ^ builtin ^ "(...);");
+          Text ", return it from a function whose return type is a Decimal, or write ";
+          Code (builtin ^ "(...) : Decimal[9, 4]");
+          Text "."
+        ]
+    in
+    let result_type _: int * int =
+      match asserted_ty with
+      | Some (DecimalTy (p, s)) -> (p, s)
+      | _ -> no_result_type ()
+    in
+    (* `Option[Decimal[p, s]]` for the checked forms. *)
+    let optional_result_type _: ty * int * int =
+      match asserted_ty with
+      | Some ((NamedType (n, [DecimalTy (p, s)], _)) as ty)
+           when (equal_module_name (source_module_name n) pervasive_module_name)
+                && (ident_string (original_name n) = "Option") ->
+         (ty, p, s)
+      | _ ->
+         decimal_error [
+             Text "The result type of ";
+             Code builtin;
+             Text " comes from where it is used, and it must be an Option of a Decimal, as in ";
+             Code ("let r: Option[Decimal[9, 4]] := " ^ builtin ^ "(...);")
+           ]
+    in
+    (* The checked forms call the runtime twice: once for the verdict, once for
+       the value. Both calls evaluate the operand expressions. *)
+    let optional (ty: ty) (ok: texpr) (value: texpr): texpr =
+      TIfExpression (
+          ok,
+          TUnionConstructor (ty, make_ident "Some", [(make_ident "value", value)]),
+          TUnionConstructor (ty, make_ident "None", [])
+        )
+    in
+    let sp = Printf.sprintf in
+    Some
+      (match (builtin, args) with
+       | ("divide", [a; b; mode]) ->
+          let (a, _, s1) = decimal_operand a
+          and (b, _, s2) = decimal_operand b
+          and mode = mode_operand mode in
+          let (p3, s3) = result_type () in
+          TEmbed (DecimalTy (p3, s3), sp "au_dec_div($1, %d, $2, %d, %d, %d, (int)($3).tag)" s1 s2 p3 s3, [a; b; mode])
+       | ("divide", _) ->
+          wrong_arity 3
+       | ("round", [x; mode]) ->
+          let x' = operand x
+          and mode = mode_operand mode in
+          let (p2, s2) = result_type () in
+          (match get_type x' with
+           | DecimalTy (_, s) ->
+              TEmbed (DecimalTy (p2, s2), sp "au_dec_round($1, %d, %d, %d, (int)($2).tag)" s p2 s2, [x'; mode])
+           | DoubleFloat ->
+              TEmbed (DecimalTy (p2, s2), sp "au_dec_from_double($1, %d, %d, (int)($2).tag)" p2 s2, [x'; mode])
+           | ty ->
+              decimal_error [Text "The built-in "; Code "round"; Text " takes a Decimal or a Float64, but got a value of type "; Type ty; Text "."])
+       | ("round", _) ->
+          wrong_arity 2
+       | ("exact", [x]) ->
+          let x' = operand x in
+          let (p2, s2) = result_type () in
+          (match get_type x' with
+           | DecimalTy (_, s) ->
+              TEmbed (DecimalTy (p2, s2), sp "au_dec_exact($1, %d, %d, %d)" s p2 s2, [x'])
+           | Integer _ ->
+              TEmbed (DecimalTy (p2, s2), sp "au_dec_exact((au_decimal_t)($1), 0, %d, %d)" p2 s2, [x'])
+           | ty ->
+              decimal_error [Text "The built-in "; Code "exact"; Text " takes a Decimal or an integer, but got a value of type "; Type ty; Text "."])
+       | ("exact", _) ->
+          wrong_arity 1
+       | ("widen", [x]) ->
+          let x' = operand x in
+          let (p2, s2) = result_type () in
+          let source_ty = get_type x' in
+          (* The source as (digits before the point, scale). *)
+          let (int_digits, s, conversion) =
+            (match source_ty with
+             | DecimalTy (p, s) -> (p - s, s, "$1")
+             | Integer (signedness, width) -> (integer_type_digits signedness width, 0, "(au_decimal_t)($1)")
+             | ty ->
+                decimal_error [Text "The built-in "; Code "widen"; Text " takes a Decimal or an integer, but got a value of type "; Type ty; Text "."])
+          in
+          if (s2 >= s) && ((p2 - s2) >= int_digits) then
+            TEmbed (DecimalTy (p2, s2), sp "zd_widen(%s, %d, %d)" conversion s s2, [x'])
+          else
+            decimal_error [
+                Text "Cannot widen ";
+                Type source_ty;
+                Text " to ";
+                Type (DecimalTy (p2, s2));
+                Text ": the target needs a scale of at least ";
+                Text (string_of_int s);
+                Text " and at least ";
+                Text (string_of_int int_digits);
+                Text " digits before the point. Use ";
+                Code "round";
+                Text " or ";
+                Code "exact";
+                Text " for a conversion that can lose digits."
+              ]
+       | ("widen", _) ->
+          wrong_arity 1
+       | ("checkedAdd", [a; b]) ->
+          let (ty, p, s) = optional_result_type () in
+          let checked_operand (e: aexpr): texpr =
+            let e' =
+              (match decimal_literal_text e with
+               | Some text -> decimal_literal_as p s text
+               | None -> aug ctx e)
+            in
+            let _ = match_type_ctx ctx (DecimalTy (p, s)) (get_type e') in
+            e'
+          in
+          let a = checked_operand a
+          and b = checked_operand b in
+          optional ty
+            (TEmbed (Boolean, sp "zd_add($1, $2, %d, &(au_decimal_t){0})" p, [a; b]))
+            (TEmbed (DecimalTy (p, s), sp "au_dec_add($1, $2, %d)" p, [a; b]))
+       | ("checkedAdd", _) ->
+          wrong_arity 2
+       | ("checkedDivide", [a; b; mode]) ->
+          let (a, _, s1) = decimal_operand a
+          and (b, _, s2) = decimal_operand b
+          and mode = mode_operand mode in
+          let (ty, p3, s3) = optional_result_type () in
+          optional ty
+            (TEmbed (Boolean, sp "zd_div($1, %d, $2, %d, %d, %d, (zd_mode)($3).tag, &(au_decimal_t){0})" s1 s2 p3 s3, [a; b; mode]))
+            (TEmbed (DecimalTy (p3, s3), sp "au_dec_div($1, %d, $2, %d, %d, %d, (int)($3).tag)" s1 s2 p3 s3, [a; b; mode]))
+       | ("checkedDivide", _) ->
+          wrong_arity 3
+       | ("debugPrintDecimal", [x]) ->
+          let (x, _, s) = decimal_operand x in
+          TEmbed (Unit, sp "(au_dec_debug_print($1, %d), nil)" s, [x])
+       | ("debugPrintDecimal", _) ->
+          wrong_arity 1
+       | _ ->
+          internal_err ("unknown Decimal built-in: " ^ builtin))
+
