+   The expected type does not reach an argument while it is being checked, so this
+   runs afterwards on the checked arguments, where the literal's text is still there. *)
+let coerce_decimal_literal_args (params: value_parameter list) (args: texpr list): texpr list =
+  if (List.length params) <> (List.length args) then
+    args
+  else
+    List.map2
+      (fun (ValueParameter (_, ty)) arg ->
+        match (ty, arg) with
+        | (DecimalTy (p, s), TIntConstant text) -> decimal_literal_as p s text
+        | (DecimalTy (p, s), TFloatConstant text) -> decimal_literal_as p s text
+        | _ -> arg)
+      params
+      args
+
+let augment_decimal_arithmetic (op: arithmetic_operator) ((lhs, lhs'): aexpr * texpr) ((rhs, rhs'): aexpr * texpr) (asserted_ty: ty option): texpr =
+  let not_decimal (symbol: string) (a: ty) (b: ty) =
+    decimal_error [
+        Text "Both operands of ";
+        Code symbol;
+        Text " must be Decimal values or literals, but their types are ";
+        Type a;
+        Text " and ";
+        Type b;
+        Text "."
+      ]
