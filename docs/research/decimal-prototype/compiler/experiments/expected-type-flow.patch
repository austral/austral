+    | (_, Some l, Some r) ->
+       (l, r)
+    | ((Add | Subtract), Some l, None) when is_decimal_type (get_type l) ->
+       (l, augment_expr ctx (Some (get_type l)) rhs)
+    | ((Add | Subtract), None, Some r) when is_decimal_type (get_type r) ->
+       (augment_expr ctx (Some (get_type r)) lhs, r)
+    | _ ->
+       (* Runs again to raise the original error. *)
+       (augment_expr ctx operand_ty lhs, augment_expr ctx operand_ty rhs)
