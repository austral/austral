+(* Experiment: when the callee is a plain function, a parameter declared with a
+   Decimal type is the expected type of its argument. *)
+and augment_arglist_expecting (ctx: expr_ctx) (name: qident) (args: abstract_arglist): typed_arglist =
+  let params: value_parameter list option =
+    if get_var (ctx_lexenv ctx) (local_name name) <> None then
+      None
+    else
+      match get_callable (ctx_env ctx) (ctx_module_name ctx) (qident_to_sident name) with
+      | Some (FunctionCallable (_, _, params, _)) -> Some params
+      | _ -> None
+  in
+  let expected (ValueParameter (_, ty)): ty option =
+    if is_decimal_type ty then Some ty else None
+  in
+  match (args, params) with
+  | (Positional es, Some ps) when (List.length es) = (List.length ps) ->
+     TPositionalArglist (List.map2 (fun e p -> augment_expr ctx (expected p) e) es ps)
+  | (Named pairs, Some ps) ->
+     let expected_by_name (n: identifier): ty option =
+       match List.find_opt (fun (ValueParameter (pn, _)) -> equal_identifier pn n) ps with
+       | Some p -> expected p
+       | None -> None
+     in
+     TNamedArglist (List.map (fun (n, e) -> (n, augment_expr ctx (expected_by_name n) e)) pairs)
+  | _ ->
+     augment_arglist ctx args
+
 and augment_arglist (ctx: expr_ctx) (args: abstract_arglist): typed_arglist =
