+  (* Experiment: the operands of + and - have the result's type, so an expected
+     Decimal type goes down to them. With no expected type, an operand that
+     cannot be typed alone takes the type of the other operand. *)
+  let operand_ty: ty option =
+    match (op, asserted_ty) with
+    | ((Add | Subtract), Some (DecimalTy _)) -> asserted_ty
+    | _ -> None
+  in
+  let try_operand (e: aexpr): texpr option =
+    try Some (augment_expr ctx operand_ty e) with Austral_error _ -> None
+  in
+  let (lhs', rhs') =
