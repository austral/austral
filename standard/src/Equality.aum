module body Standard.Equality is
    instance PartialEquality(Unit) is
        generic [R: Region, S: Region]
		method partialEq(a: &[Unit, R], b: &[Unit, S]): Bool is
             return true;
        end;
    end;

    instance Equality(Unit) is
        generic [R: Region, S: Region]
		method equal(a: &[Unit, R], b: &[Unit, S]): Bool is
             return true;
        end;
    end;

    instance PartialEquality(Bool) is
        generic [R: Region, S: Region]
		method partialEq(a: &[Bool, R], b: &[Bool, S]): Bool is
            let av: Bool := !a;
            let bv: Bool := !b;
            return av = bv;
        end;
    end;

    instance Equality(Bool) is
        generic [R: Region, S: Region]
		method equal(a: &[Bool, R], b: &[Bool, S]): Bool is
            let av: Bool := !a;
            let bv: Bool := !b;
            return av = bv;
        end;
    end;

    instance PartialEquality(Nat8) is
        generic [R: Region, S: Region]
		method partialEq(a: &[Nat8, R], b: &[Nat8, S]): Bool is
            let av: Nat8 := !a;
            let bv: Nat8 := !b;
            return av = bv;
        end;
    end;

    instance Equality(Nat8) is
        generic [R: Region, S: Region]
		method equal(a: &[Nat8, R], b: &[Nat8, S]): Bool is
